# =============================================================
#  Fichier    : .env.example
#  Projet     : Kalami
#  Description: Modèle des variables d'environnement. Copier en .env.local (développement)
#               et les définir dans Vercel (Preview / Production). Ne JAMAIS y mettre de valeurs.
#  Auteur     : Claude Marcel
#  Version    : 1.0
#  Date       : 2026-10-06
# =============================================================

# ==================== APPLICATION ====================
# Nom affiché de la plateforme (défaut : Kalami)
NEXT_PUBLIC_APP_NAME=Kalami
# URL publique du domaine principal (défaut : https://kalami-livres.com ; local : http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domaines secondaires redirigés en 301 vers NEXT_PUBLIC_APP_URL, séparés par des virgules
# ex. kalami-books.com,www.kalami-livres.com
REDIRECT_DOMAINS=

# ==================== SUPABASE ====================
# Tableau de bord Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (sb_publishable_...) — utilisable côté navigateur, protégée par la RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_...) — SERVEUR UNIQUEMENT, contourne la RLS
SUPABASE_SECRET_KEY=
# Mot de passe de la base (Settings → Database) : migrations via « supabase db push --db-url »
SUPABASE_DB_PASSWORD=

# ==================== PDF FILIGRANÉ ====================
# Local seulement : chemin de Chrome (sur Vercel, @sparticuz/chromium est utilisé)
# ex. C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_EXECUTABLE_PATH=
# Secret de la tâche quotidienne de suppression des PDF expirés (Vercel → Environment
# Variables) ; Vercel l'envoie automatiquement aux tâches planifiées
CRON_SECRET=

# ==================== COURRIELS (RESEND) ====================
# Stratégie S9a — invitations à une étude ; S9b — courriels de mention (chaque membre peut
# les désactiver). Sans clé, aucun envoi : le lien d'invitation s'affiche à copier et les
# mentions restent dans la cloche. EMAIL_FROM doit utiliser un domaine vérifié chez Resend.
RESEND_API_KEY=
EMAIL_FROM="Kalami <invitations@kalami-livres.com>"

# ==================== STRIPE (paiement par carte, v0.10.0) ====================
# Serveur seulement, jamais NEXT_PUBLIC_ (Stripe Checkout : aucune clé publique utile).
# Compte partagé avec d'autres applications : les sessions Kalami portent metadata.app=kalami.
STRIPE_SECRET_KEY=
# Clé de signature de la destination « kalami-paiements »
# (https://www.kalami-livres.com/api/stripe/webhook, checkout.session.completed / expired)
STRIPE_WEBHOOK_SECRET=
# Prix (price_…) du tableau de bord : servent à retrouver le produit Stripe ;
# le montant facturé vient toujours de la base
STRIPE_PRICE_LIVRE_STRATEGIE=
STRIPE_PRICE_ETUDE=
STRIPE_PRICE_LOT_10=
STRIPE_PRICE_LOT_30=
STRIPE_PRICE_COACH_ESSENTIEL=
STRIPE_PRICE_COACH_APPROFONDI=
STRIPE_PRICE_COACH_INTENSIF=
